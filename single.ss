
.home-content{
    height: 100vh;
    /* background: linear-gradient(165deg,rgb(2, 2, 70),
    rgb(41, 2, 131),rgb(11, 0, 31)); */
    background: #223;
    color: white;
    padding: 20px;
    font-family: sans-serif;

    
}

.home-content h1{
    color: white;
    margin-top: 150px;
    margin-bottom: 5px;
    font-size: 50px;
}
.home-content span{
    color: aqua;
}
.home-content p{
    margin: 30px 0px;
}

.home-content a{
    text-decoration: none;
    text-align: center;
    color: darkblue;
    font-weight: bold;

}
.home-content .button{
    padding: 20px;
    background: aqua;
    border-radius: 10px;
}







*{
    padding: 0;
    margin:0;
    box-sizing: border-box;
}

header{
    display: flex;
    justify-content: space-between;
    align-items: center;
    text-align: center;
    padding: 10px;
    background-color: rgb(0, 0, 24);
    color: white;
}
header .logo h2{
    color: aqua;
    font-family: sans-serif;
}
nav{
    display: flex;
    gap: 20px;
    font-family: sans-serif;
}
nav a{
    text-decoration: none;
    color: white;
}

/* Home-page */

#home{
    min-width: 550px;
    padding: 100px 70%;
    display: flex;
    align-items: center;
    background: linear-gradient(135deg,#102a43, #176b87);
    color: white;
}

.home-content{
    max-width: 700px;
}






